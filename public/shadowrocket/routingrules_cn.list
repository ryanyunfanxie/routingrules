# Mainland China whitelist routing rules
# v2rayN-style Mainland China Whitelist: China traffic DIRECT, everything else PROXY.
# Generated from config/services_cn.json; checked 2026-10-02.
# This is a whitelist profile; it intentionally ends with a proxy fallback.

AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT
DOMAIN-SUFFIX,google.com,PROXY
DOMAIN-SUFFIX,google.com.hk,PROXY
DOMAIN-SUFFIX,google.cn,PROXY
DOMAIN-SUFFIX,googleapis.com,PROXY
DOMAIN-SUFFIX,googleapis.cn,PROXY
DOMAIN-SUFFIX,gstatic.com,PROXY
DOMAIN-SUFFIX,googleusercontent.com,PROXY
DOMAIN-SUFFIX,gmail.com,PROXY
DOMAIN-SUFFIX,googlevideo.com,PROXY
GEOIP,LAN,DIRECT
GEOIP,CN,DIRECT
FINAL,PROXY
